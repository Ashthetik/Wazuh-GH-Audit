[Unit]
Description=GitHub Webhook Receiver for Wazuh ingestion
After=network.target

[Service]
Type=simple
User=github-webhook
Group=github-webhook
WorkingDirectory=/opt/github-webhook
EnvironmentFile=-/etc/github-webhook/env
ExecStart=/opt/github-webhook/venv/bin/gunicorn -w 2 -b 127.0.0.1:8787 --access-logfile - main:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/github-webhooks
PrivateTmp=true

[Install]
WantedBy=multi-user.target